# Copy to .env and fill in. Never commit .env.

# --- App (bundled into the phone app; public values only) ---
# For local development, `pnpm supabase start` prints these (API_URL and ANON_KEY).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Server side only (Edge Functions). NEVER use these in the app. ---
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
MAP_PROVIDER=google              # google | ola | mappls | osrm
LLM_API_KEY=                     # optional AI search (phase 9+)
SMS_PROVIDER_API_KEY=            # MSG91 / Exotel
SMS_SENDER_ID=
EXPO_ACCESS_TOKEN=               # for sending push from Edge Functions

# --- SOS dispatch config ---
SOS_WAVE_SIZE=3
SOS_WAVE_TIMEOUT_S=25
SOS_INITIAL_RADIUS_M=2000
SOS_MAX_RADIUS_M=8000
SOS_MIN_RESPONDERS=3
